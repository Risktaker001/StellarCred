# ── Database ─────────────────────────────────────────────────────────────────
DB_DRIVER=sqlite
SQLITE_PATH=./data/indexer.db

# Uncomment and set when DB_DRIVER=postgres
# DATABASE_URL=postgres://indexer:indexer@localhost:5432/indexer

# ── Stellar / Soroban ────────────────────────────────────────────────────────
RPC_URL=https://soroban-testnet.stellar.org
STELLAR_NETWORK=testnet
PROOF_REGISTRY_CONTRACT_ID=

POLL_INTERVAL_SECONDS=6
START_LEDGER=0

# ── HTTP server ───────────────────────────────────────────────────────────────
PORT=3001

# ── Authentication (optional) ────────────────────────────────────────────────
# Leave API_KEY unset (or empty) to run in public mode — all endpoints are
# open, matching the default described in README.md §Authentication.
#
# Set API_KEY to a strong random secret to switch to authenticated mode.
# In that mode callers must supply the key on every request to /claims,
# /stats, and /recent as one of:
#   Authorization: Bearer <key>
#   X-API-Key: <key>
# /health is always public regardless of this setting.
#
# Generate a suitable key with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
# API_KEY=

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins, or * to allow any origin (default).
# Restrict this in authenticated mode to prevent browser clients from sending
# credentials to unintended origins.
#
# Examples:
#   CORS_ORIGIN=*
#   CORS_ORIGIN=https://app.example.com
#   CORS_ORIGIN=https://app.example.com,https://staging.example.com
#
CORS_ORIGIN=*
